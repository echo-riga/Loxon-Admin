ADMIN_PASSWORD_HASH=
# Generate at least 32 random characters
ADMIN_SESSION_SECRET=

# Exact comma-separated browser origins allowed to call this API
ALLOWED_ORIGINS=https://your-public-site.example,https://your-admin-site.example

# Upstash Redis REST credentials (server-only)
